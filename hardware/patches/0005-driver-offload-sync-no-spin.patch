OASIS 0005 -- driver offload/sync: refuse an address that starts no mapped buffer instead of spinning.
Apply on top of 0003 and 0004 (git -C parcore/libstf/coyote apply 0003-..., 0004-..., then 0005-...).
Only reachable on EN_MEM shells: without card memory the ioctl refuses offload/sync before this code.

offload_user_pages() and sync_user_pages() walk [vaddr, vaddr + len) and look each position up with
hash_for_each_possible(user_buff_map, ..., vaddr_tmp), but tlb_get_user_pages() hashes a mapped
buffer under its START page only. For a vaddr_tmp inside a buffer (or inside none) the bucket holds
no match, vaddr_tmp never advances, and the while loop spins inside the ioctl with no resched and no
signal check: an unkillable task, a soft lockup, a reboot. build-131, 2026-09-25: the rev-5 host
offloaded its 1 GiB slot page as 8 x 128 MiB; the first call (at the page start) migrated the WHOLE
page, the second (at +128 MiB) never returned (RIP offload_user_pages+0xe2, empty bucket, R14 = 0).

Now every pass over the bucket has to find a buffer that covers vaddr_tmp. If none does, the call
logs one pr_warn (address, request, len, ctid, hpid, pid) and returns -EINVAL; vfpga_dev_ioctl hands
it back, so ioctl() returns -1/EINVAL and cThread::invoke() throws "ERROR: IOCTL_OFFLOAD_REQ failed"
(IOCTL_SYNC_REQ for a sync). A buffer migrated earlier in the same call stays migrated. A call at a
buffer's start behaves exactly as before: it migrates the whole buffer, whatever len says.

diff --git a/driver/src/vfpga/vfpga_gup.c b/driver/src/vfpga/vfpga_gup.c
index 5ab37cd..72c2d47 100644
--- a/driver/src/vfpga/vfpga_gup.c
+++ b/driver/src/vfpga/vfpga_gup.c
@@ -698,6 +698,11 @@ int offload_user_pages(struct vfpga_dev *device, uint64_t vaddr, uint32_t len, i
 
     struct user_pages *tmp_entry;
     while (vaddr_tmp <= vaddr_last) {
+        // OASIS 0005: buffers are hashed under their START page, so a vaddr_tmp that is not the start
+        // of a mapped buffer (an address inside one, or an unmapped one) lands in a bucket that holds
+        // no match, vaddr_tmp never advances and this loop spun forever in the ioctl, unkillable
+        // (build-131, 2026-09-25: soft lockup in offload_user_pages, board rebooted). Refuse instead.
+        bool found = false;
         hash_for_each_possible(user_buff_map[device->id][ctid], tmp_entry, entry, vaddr_tmp) {
             if(vaddr_tmp >= tmp_entry->vaddr && vaddr_tmp < tmp_entry->vaddr + tmp_entry->n_pages) {
                 struct pf_aligned_desc pf_desc;
@@ -712,10 +717,17 @@ int offload_user_pages(struct vfpga_dev *device, uint64_t vaddr, uint32_t len, i
                 migrate_to_card(device, tmp_entry);
                 tlb_map_gup(device, &pf_desc, tmp_entry, hpid);
                 ret_val = 0;
+                found = true;
 
                 vaddr_tmp += tmp_entry->n_pages;
             }
         }
+
+        if (!found) {
+            pr_warn("%s():refused, no mapped buffer starts at %llx (request %llx, len %u), ctid %d, hpid %d, pid %d\n", __func__,
+                vaddr_tmp << PAGE_SHIFT, vaddr, len, ctid, hpid, current->pid);
+            return -EINVAL;
+        }
     }
 
     return ret_val;
@@ -737,6 +749,8 @@ int sync_user_pages(struct vfpga_dev *device, uint64_t vaddr, uint32_t len, int3
     // Iterate, until all the pages have been synced
     struct user_pages *tmp_entry;
     while (vaddr_tmp <= vaddr_last) {
+        // OASIS 0005: same lookup and same endless loop as offload_user_pages(); refuse instead.
+        bool found = false;
         hash_for_each_possible(user_buff_map[device->id][ctid], tmp_entry, entry, vaddr_tmp) {
             if(vaddr_tmp >= tmp_entry->vaddr && vaddr_tmp < tmp_entry->vaddr + tmp_entry->n_pages) {
                 struct pf_aligned_desc pf_desc;
@@ -751,10 +765,17 @@ int sync_user_pages(struct vfpga_dev *device, uint64_t vaddr, uint32_t len, int3
                 migrate_to_host(device, tmp_entry);
                 tlb_map_gup(device, &pf_desc, tmp_entry, hpid);
                 ret_val = 0;
+                found = true;
 
                 vaddr_tmp += tmp_entry->n_pages;
             }
         }
+
+        if (!found) {
+            pr_warn("%s():refused, no mapped buffer starts at %llx (request %llx, len %u), ctid %d, hpid %d, pid %d\n", __func__,
+                vaddr_tmp << PAGE_SHIFT, vaddr, len, ctid, hpid, current->pid);
+            return -EINVAL;
+        }
     }
 
     return ret_val;
