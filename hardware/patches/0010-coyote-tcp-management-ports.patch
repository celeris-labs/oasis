+        .tcp_listen_rsp_data    (tcp_listen_rsp_ul[{{ i }}].data),
+        .tcp_open_req_valid	    (tcp_open_req_ul[{{ i }}].valid),
+        .tcp_open_req_ready	    (tcp_open_req_ul[{{ i }}].ready),
+        .tcp_open_req_data	    (tcp_open_req_ul[{{ i }}].data),
