Oasis patch 0010 for parcore/libstf/coyote (base 003c7344, branch dev/tcp): the TCP open, listen and
close interfaces are wired to the user logic instead of the MMU, so the vFPGA opens and closes its own
sessions, and util/program_hacc_local.sh is made executable. Applied by apply.sh.

diff --git a/hw/templates/common/dynamic_top_tmplt.txt b/hw/templates/common/dynamic_top_tmplt.txt
index 287eca5..328b4d8 100644
--- a/hw/templates/common/dynamic_top_tmplt.txt
+++ b/hw/templates/common/dynamic_top_tmplt.txt
@@ -911,6 +911,21 @@ module design_dynamic_top #(
     metaIntf #(.STYPE(tcp_open_rsp_t)) tcp_open_rsp_ul [N_REGIONS]();
     metaIntf #(.STYPE(tcp_close_req_t)) tcp_close_req_ul [N_REGIONS]();
 
+    // Unused MMU/cnfg_slave TCP management (vFPGA drives open/listen/close instead)
+    metaIntf #(.STYPE(tcp_listen_req_t)) tcp_listen_req_mmu_unused [N_REGIONS]();
+    metaIntf #(.STYPE(tcp_listen_rsp_t)) tcp_listen_rsp_mmu_unused [N_REGIONS]();
+    metaIntf #(.STYPE(tcp_open_req_t))   tcp_open_req_mmu_unused   [N_REGIONS]();
+    metaIntf #(.STYPE(tcp_open_rsp_t))   tcp_open_rsp_mmu_unused   [N_REGIONS]();
+    metaIntf #(.STYPE(tcp_close_req_t))  tcp_close_req_mmu_unused  [N_REGIONS]();
+
+    for (genvar i = 0; i < N_REGIONS; i++) begin : TCP_MMU_MGMT_TIEOFF
+        always_comb tcp_listen_req_mmu_unused[i].ready = 1'b1;
+        always_comb tcp_open_req_mmu_unused[i].ready   = 1'b1;
+        always_comb tcp_close_req_mmu_unused[i].ready  = 1'b1;
+        always_comb tcp_listen_rsp_mmu_unused[i].tie_off_m();
+        always_comb tcp_open_rsp_mmu_unused[i].tie_off_m();
+    end
+
     metaIntf #(.STYPE(tcp_notify_t)) tcp_notify_ul [N_REGIONS]();
     metaIntf #(.STYPE(tcp_rd_pkg_t)) tcp_rd_pkg_ul [N_REGIONS]();
     metaIntf #(.STYPE(tcp_rx_meta_t)) tcp_rx_meta_ul [N_REGIONS]();
@@ -1132,11 +1147,13 @@ module design_dynamic_top #(
         .s_rdma_cq(rdma_host_cq_s1),
 {% endif %}
