-        .s_tcp_open_rsp  (tcp_open_rsp_ul),
-        .m_tcp_close_req (tcp_close_req_ul),
+        // TCP management driven by vFPGA (user_wrapper), not cnfg_slave.
+        // Swallow unused SW open/listen/close from the MMU path.
+        .m_tcp_listen_req(tcp_listen_req_mmu_unused),
+        .s_tcp_listen_rsp(tcp_listen_rsp_mmu_unused),
+        .m_tcp_open_req  (tcp_open_req_mmu_unused),
+        .s_tcp_open_rsp  (tcp_open_rsp_mmu_unused),
+        .m_tcp_close_req (tcp_close_req_mmu_unused),
 {% endif %}
 {% if cnfg.en_wb %}
