diff --git a/hw/hdl/network/tcp/tcp_mem_mux.sv b/hw/hdl/network/tcp/tcp_mem_mux.sv
new file mode 100644
index 00000000..56908414
--- /dev/null
+++ b/hw/hdl/network/tcp/tcp_mem_mux.sv
@@ -0,0 +1,537 @@
+/**
+ * This file is part of the Coyote <https://github.com/fpgasystems/Coyote>
+ *
+ * MIT Licence
+ * Copyright (c) 2021-2025, Systems Group, ETH Zurich
+ * All rights reserved.
+ *
