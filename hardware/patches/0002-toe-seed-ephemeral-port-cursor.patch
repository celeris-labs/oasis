 	free_port_table(sLookup2portTable_releasePort,
 						pt_portCheckUsed_req_fifo,
-						//txApp2portTable_port_req,
+						txApp2portTable_port_req,
 						pt_portCheckUsed_rsp_fifo,
 						portTable2txApp_port_rsp);
 
