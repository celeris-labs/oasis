Oasis patch 0002 for parcore/libstf/coyote/hw/services/network (base 20633d0): the ephemeral-port
cursor is loaded from a free-running counter at the first open request instead of starting at 32768
after every reset, so a reprogrammed board does not reuse the previous load's 4-tuples. The object
server still holds those connections and answers a SYN on one of them with an ACK for the old
connection, so the new one never opens. Applied by apply.sh.

diff --git a/hls/toe/port_table/port_table.cpp b/hls/toe/port_table/port_table.cpp
index 8482a40..f5964ba 100755
--- a/hls/toe/port_table/port_table.cpp
+++ b/hls/toe/port_table/port_table.cpp
@@ -113,7 +113,7 @@ void listening_port_table(	stream<ap_uint<16> >&	rxApp2portTable_listen_req,
  */
 void free_port_table(	stream<ap_uint<16> >&	sLookup2portTable_releasePort,
 						stream<ap_uint<15> >&	pt_portCheckUsed_req_fifo,
-						//stream<ap_uint<1> >&	txApp2portTable_port_req,
+						stream<ap_uint<1> >&	txApp2portTable_port_req,
 						stream<bool>&			pt_portCheckUsed_rsp_fifo,
 						stream<ap_uint<16> >&	portTable2txApp_port_rsp)
 {
@@ -130,10 +130,20 @@ void free_port_table(	stream<ap_uint<16> >&	sLookup2portTable_releasePort,
 #endif
 
 	static ap_uint<FREE_PORT_BITS> pt_cursor = 0;
+	// Every bitstream load resets pt_cursor, and portTable2txApp_port_rsp is pre-filled a few
+	// cycles after reset -- so every load handed out 32768, 32769, ... in the same order. A server
+	// still holding the previous load's sockets answers those SYNs with an ACK for the old
+	// connection, and the open never completes. Nothing is allocated until tx_app_if reports the
+	// first open request, and the cursor starts wherever a free-running counter stands on that
+	// cycle: an instant set by the host, not by reset, so it differs from one load to the next.
+	static ap_uint<FREE_PORT_BITS> pt_seedCounter = 0;
+	static bool pt_seeded = false;
 
 	ap_uint<16> currPort;
 	ap_uint<16> freePort;
 
+	pt_seedCounter++;
+
 	if (!sLookup2portTable_releasePort.empty())
 	{
 		sLookup2portTable_releasePort.read(currPort);
@@ -147,6 +157,15 @@ void free_port_table(	stream<ap_uint<16> >&	sLookup2portTable_releasePort,
 		ap_uint<15> checkIdx = pt_portCheckUsed_req_fifo.read();
 		pt_portCheckUsed_rsp_fifo.write(freePortTable[checkIdx(FREE_PORT_BITS-1, 0)]);
 	}
+	else if (!pt_seeded)
+	{
+		if (!txApp2portTable_port_req.empty())
+		{
+			txApp2portTable_port_req.read();
+			pt_cursor = pt_seedCounter;
+			pt_seeded = true;
+		}
+	}
 	else
 	{
 		bool used = freePortTable[pt_cursor];
@@ -161,10 +180,6 @@ void free_port_table(	stream<ap_uint<16> >&	sLookup2portTable_releasePort,
 			pt_cursor++;
 		}
 	}
-	/*if (!txApp2portTable_port_req.empty()) //Fixme this!!!
-	{
-		txApp2portTable_port_req.read();
-	}*/
 }
 
 
