diff --git a/driver/include/coyote_defs.h b/driver/include/coyote_defs.h
index 930a0d8..001e67c 100644
--- a/driver/include/coyote_defs.h
+++ b/driver/include/coyote_defs.h
@@ -340,8 +340,17 @@ extern bool en_hmm;
     #define N_MEM_BLOCKS 1
     #define MEM_BLOCK_SIZE 0    // doesn't matter; effectively unused in this case but needed to compile
     #define MEM_START (256UL * 1024UL * 1024UL)
-    #define N_SMALL_CHUNKS (1024UL * 1024UL)
-    #define N_LARGE_CHUNKS (1024UL * 1024UL)
+    // OASIS 2026-09-20: upstream gives 4 GB to each pool (1024 * 1024 chunks of 4 KB).
+    // Both pools only exist when the shell is built with EN_MEM=1; with en_mem the driver
+    // allocates a card-memory shadow for every buffer a process maps (vfpga_gup.c ->
+    // alloc_card_memory), and huge pages are accounted in 4 KB chunks too, because
+    // pf_desc.n_pages is multiplied by n_pages_in_huge before the call. One 1 GB huge page
+    // therefore costs 262144 chunks and the 5th mapped huge page fails against a 4 GB pool.
+    // OASIS maps up to LIBSTF_HUGE_PAGES=10 huge pages plus one 1 GB page for the HBM
+    // receive slots, so the huge pool has to hold >= 12 GB; the regular pool never needed
+    // 4 GB. Layout in the U55C's 16 GB HBM: MEM_START 0.25 + small 1 + huge 12 = 13.25 GB.
+    #define N_SMALL_CHUNKS (256UL * 1024UL)             // 1 GB of regular (4 KB) pages
+    #define N_LARGE_CHUNKS (12UL * 256UL * 1024UL)      // 12 GB of huge pages
 #endif
 
