Oasis patch 0009 for parcore/libstf/coyote/hw/services/network (base 20633d0): TCP window
256 KiB -> 1 MiB (WINDOW_SCALE_BITS 2 -> 4). Applied by apply.sh.

diff --git a/hls/toe/toe_config.hpp.in b/hls/toe/toe_config.hpp.in
index 5fe0fb6..73d40e9 100644
--- a/hls/toe/toe_config.hpp.in
+++ b/hls/toe/toe_config.hpp.in
@@ -23,7 +23,15 @@ const unsigned DATA_KEEP_BITS = ConstLog2(DATA_WIDTH/8);
 
 //TCP window scaling option
 #define WINDOW_SCALE ${TCP_STACK_WINDOW_SCALING_EN}
-const unsigned WINDOW_SCALE_BITS = 2;
+// Raised 2 -> 4 for oasis (window 256 KiB -> 1 MiB, BUFFER_SIZE below follows). The window, the
+// receive buffer size and each connection's transmit ring grow four times with it, and a connection
+// may have up to 1 MiB of a response in flight before the reader has to reopen the window.
+//
+// The receive fifo MUST be resized to match (rx_buffer_fifo in hw/hdl/network/tcp/tcp_stack.sv, and
+// the axis_max_data_count constants feeding the TOE). The stack advertises BUFFER_SIZE regardless of
+// real free space, so a window larger than the fifo invites the peer to send what has to be dropped,
+// and the recovery is go-back-N with out-of-order buffering disabled.
+const unsigned WINDOW_SCALE_BITS = 4;
 #if (WINDOW_SCALE)
 const unsigned WINDOW_BITS = 16 + WINDOW_SCALE_BITS;
 #else
