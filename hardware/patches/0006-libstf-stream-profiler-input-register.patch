OASIS 0006 -- libstf StreamProfiler: register the observed stream's valid/ready/last and stop.
Working-tree change to the parcore/libstf submodule (expected HEAD 31d98eb), made 2026-09-26 for the
build-133 timing fixes. Apply from the repo root:
    git -C parcore/libstf apply --check ../../hardware/patches/0006-libstf-stream-profiler-input-register.patch
    git -C parcore/libstf apply         ../../hardware/patches/0006-libstf-stream-profiler-input-register.patch
See hardware/patches/README.md, "The StreamProfiler input register (0006)".

diff --git a/hardware/src/hdl/util/stream_profiler.sv b/hardware/src/hdl/util/stream_profiler.sv
index 48a14e1..840462f 100644
--- a/hardware/src/hdl/util/stream_profiler.sv
+++ b/hardware/src/hdl/util/stream_profiler.sv
@@ -36,6 +36,29 @@ data64_t stalled_reg,    n_stalled_reg;
 data64_t idle_reg,       n_idle_reg;
 data64_t idle_acc_reg,   n_idle_acc_reg;
 
+// The inputs, REGISTERED before anything counts them (oasis, 2026-09-26). The observed stream's
+// ready is usually a deep cone of its consumer (ColumnChunkDecoder's in.ready comes from the page
+// header parser's byte counter), and it fanned out into the clock enables of the 64-bit counters
+// below -- on a placed 4-decoder build that was the worst path of the design, across an SLR
+// boundary (-2.188 ns: page_header_parser -> inst_profile_in handshakes CE). With every input,
+// stop included, taken through one register the profiler is exactly its old self delayed by one
+// cycle: the same counts, reported one cycle later. Nothing observed is touched.
+logic last_q, valid_q, ready_q, stop_q;
+
+always_ff @(posedge clk) begin
+    if (!rst_n) begin
+        last_q  <= 1'b0;
+        valid_q <= 1'b0;
+        ready_q <= 1'b0;
+        stop_q  <= 1'b0;
+    end else begin
+        last_q  <= last;
+        valid_q <= valid;
+        ready_q <= ready;
+        stop_q  <= profile.stop;
+    end
+end
+
 always_ff @(posedge clk) begin
     if (!rst_n) begin
         state <= WAIT;
@@ -67,7 +90,7 @@ always_comb begin
 
     case (state)
         WAIT: begin
-            if (valid) begin
+            if (valid_q) begin
                 n_state = STREAM;
 
                 n_handshakes_reg = '0;
@@ -76,7 +99,7 @@ always_comb begin
                 n_idle_reg       = '0;
                 n_idle_acc_reg   = '0;
 
-                if (ready) begin
+                if (ready_q) begin
                     n_handshakes_reg = 1;
                 end else begin
                     n_stalled_reg = 1;
@@ -84,11 +107,11 @@ always_comb begin
             end
         end
         STREAM: begin
-            if (valid) begin
-                if (ready) begin
+            if (valid_q) begin
+                if (ready_q) begin
                     n_handshakes_reg = handshakes_reg + 1;
 
-                    if (last) begin
+                    if (last_q) begin
                         n_state = IDLE;
                     end
                 end else begin
@@ -99,16 +122,16 @@ always_comb begin
             end
         end
         IDLE: begin
-            if (valid) begin
+            if (valid_q) begin
                 n_state = STREAM;
 
                 n_idle_reg     = idle_reg + idle_acc_reg;
                 n_idle_acc_reg = '0;
 
-                if (ready) begin
+                if (ready_q) begin
                     n_handshakes_reg = handshakes_reg + 1;
 
-                    if (last) begin
+                    if (last_q) begin
                         n_state = IDLE;
                     end
                 end else begin
@@ -120,7 +143,7 @@ always_comb begin
         end
     endcase
 
-    if (profile.stop) begin
+    if (stop_q) begin
         n_state = WAIT;
     end
 end
