Oasis patch 0013 for parcore/libstf (base 7afc162): HugePageMemoryPool maps 4 free 1 GiB huge pages
instead of every one; LIBSTF_HUGE_PAGES=N changes the count, 0 takes them all. Host library only.
Applied by apply.sh.

diff --git a/software/libstf/memory_pool.cpp b/software/libstf/memory_pool.cpp
index 47aba8c..2d55c04 100644
--- a/software/libstf/memory_pool.cpp
+++ b/software/libstf/memory_pool.cpp
@@ -2,6 +2,7 @@
 
 #include <libstf/logging.hpp>
 
+#include <cstdlib>
 #include <fstream>
 #include <memory>
 
@@ -99,8 +100,36 @@ HugePageMemoryPool::HugePageMemoryPool() {
     // Immediately reuse pages
     je_mallctl_write<ssize_t>("arenas.dirty_decay_ms", 0);
 
-    // Pre-allocate all 1 Gib huge pages available in the system
+    // Take a BOUNDED number of 1 GiB huge pages, not every free one.
+    //
+    // Taking them all makes the pool hostile to everything else on the machine, including the next
+    // instance of itself: a process that grabs all 8 leaves free_hugepages at 0, and the very next
+    // one throws "Your system has 0 free 1GiB huge pages" before it can do anything. Two Oasis
+    // processes cannot coexist, a run right after another can fail depending on how fast the kernel
+    // reclaims, and a killed process blocks the machine until it does.
+    //
+    // It also costs time: OasisContext pre-maps the WHOLE pool into the FPGA TLB
+    // (ensure_tlb_mapping(initial_address, total_capacity)), so an 8 GiB pool means mapping 8 GiB
+    // before the first query, on every process.
+    //
+    // The default is four pages. An 8-column scan asks jemalloc for a single 384 MiB extent, which a
+    // 2 GiB pool cannot serve once its own allocations have fragmented the arena, and four leave half
+    // of an 8-page system free for another process. A wider scan can need more.
+    //
+    // LIBSTF_HUGE_PAGES=N takes N pages instead, so it raises the count for a wider scan;
+    // LIBSTF_HUGE_PAGES=0 takes every free page.
     auto num_huge_pages = get_number_of_available_huge_pages();
+    {
+        int wanted = 4;
+        if (const char *env = std::getenv("LIBSTF_HUGE_PAGES")) {
+            if (*env != '\0') {
+                wanted = std::atoi(env);
+            }
+        }
+        if (wanted > 0 && wanted < num_huge_pages) {
+            num_huge_pages = wanted;
+        }
+    }
     next_free_addr      = mmap(nullptr, num_huge_pages * PAGE_SIZE, PROT_READ | PROT_WRITE,
                                MAP_PRIVATE | MAP_ANONYMOUS | MAP_HUGETLB | HUGE_PAGE_TYPE, -1, 0);
     if (next_free_addr == MAP_FAILED) {
