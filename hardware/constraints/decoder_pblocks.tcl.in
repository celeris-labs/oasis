# Decoder floorplan, generated by hardware/CMakeLists.txt into the build directory. pnr_shell.tcl
# sources it on the opened design right after opt_design, so place_design, phys_opt_design and
# route_design run with the decoders pinned (see the XDC for the assignment and why).
#
# Fails the run, before anything is placed, if a decoder is missing from the floorplan or a pblock
# reaches outside Coyote's shell pblock.

set oasis_pblock_xdc "@OASIS_PBLOCK_XDC@"
set oasis_decoders   @N_DECODERS@
set oasis_user       inst_shell/inst_dynamic/inst_user_wrapper_0/inst_user_c0_0

puts "** oasis: decoder floorplan $oasis_pblock_xdc"
source $oasis_pblock_xdc

for {set l 0} {$l < $oasis_decoders} {incr l} {
    set c [get_cells -quiet "$oasis_user/gen_http_decoders\[$l\].inst_decoder"]
    if {[llength $c] != 1} { error "oasis floorplan: decoder $l not found" }
    set pb [get_pblocks -quiet -of_objects $c]
    if {[llength $pb] != 1} { error "oasis floorplan: decoder $l is in no pblock" }
    puts "** oasis: decoder $l -> $pb"
}

array unset oasis_shell_site
foreach s [get_sites -of_objects [get_pblocks pblock_inst_shell]] { set oasis_shell_site($s) 1 }
foreach pb [get_pblocks pblock_dec*] {
    if {[get_property PARENT $pb] ne "pblock_inst_shell"} { error "oasis floorplan: $pb is not inside pblock_inst_shell" }
    set sites [get_sites -of_objects $pb]
    set outside 0
    foreach s $sites { if {![info exists oasis_shell_site($s)]} { incr outside } }
    if {$outside != 0} { error "oasis floorplan: $pb holds $outside site(s) outside pblock_inst_shell" }
    puts "** oasis: $pb in [get_slrs -of_objects $sites], [llength [get_cells -of_objects $pb]] cell(s), [llength $sites] sites"
}
array unset oasis_shell_site
