# INTEGER keys (s_int = s_id, unique)
statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(a.s_id)
FROM read_oasis('{TEST_DIR}/bf_skip.parquet') a JOIN read_oasis('{TEST_DIR}/bf_skip.parquet') b ON a.s_int = b.s_int;
