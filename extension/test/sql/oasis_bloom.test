# ---------------------------------------------------------------------------
# Two joins in one query
# ---------------------------------------------------------------------------

# A chain of three scans: only the join directly between two scans is rewritten, and its filtered
# output feeds the other join. The 8 rows of bf_ext_probe x bf_ext_build have e_val 1..6, each
# matching b_val once (b_key = 3 * b_val).
statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS
SELECT x_id, e_val, b_key
FROM read_oasis('{TEST_DIR}/bf_ext_probe.parquet')
JOIN read_oasis('{TEST_DIR}/bf_ext_build.parquet') ON x_key = e_key
JOIN read_oasis('{TEST_DIR}/bf_build.parquet') ON e_val = b_val;

query IIII
SELECT bloom_used(), count(*), sum(x_id), sum(b_key) FROM got;
----
1	8	30	90

# Two independent rewritten joins: there is one hardware Bloom filter, so a probe scan that starts
# while the other one holds it runs without it. Either way, both joins are correct.
statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS
SELECT x_id AS id, e_val AS v
FROM read_oasis('{TEST_DIR}/bf_ext_probe.parquet') JOIN read_oasis('{TEST_DIR}/bf_ext_build.parquet') ON x_key = e_key
UNION ALL
SELECT e_val, b_val
FROM read_oasis('{TEST_DIR}/bf_ext_build.parquet') JOIN read_oasis('{TEST_DIR}/bf_build.parquet') ON e_val = b_val;

query II
SELECT bloom_used() >= 1, bloom_used() + bloom_skipped('in use by another scan');
----
true	2

query III
SELECT count(*), sum(id), sum(v) FROM got;
----
14	51	51

# ---------------------------------------------------------------------------
# Scans that end early or fail leave the Bloom filter usable
# ---------------------------------------------------------------------------

# Filters that prune every probe row group by its statistics (p_id = 250 is only in row group 1,
# where p_int is 250), but not the file's: the probe side ends without a single chunk
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM read_oasis('{TEST_DIR}/bf_probe.parquet') JOIN read_oasis('{TEST_DIR}/bf_build.parquet') ON p_key = b_key
WHERE p_id = 250 AND p_int = 300;
----
0

query I
SELECT bloom_used();
----
1

# LIMIT stops the probe scan (bf_ext_probe, two row groups) before all its row groups are collected
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (
    SELECT x_id FROM read_oasis('{TEST_DIR}/bf_ext_probe.parquet') JOIN read_oasis('{TEST_DIR}/bf_ext_build.parquet') ON x_key = e_key
    LIMIT 1);
----
1

query I
SELECT bloom_used();
----
1

# A probe row group larger than the hardware supports fails before the filter is used. The build
# side has fewer rows, so bf_big is the probe side.
statement error
SELECT count(*) FROM read_oasis('{TEST_DIR}/bf_build.parquet') JOIN read_oasis('{TEST_DIR}/bf_big.parquet') ON b_key = k;
----
more than the 131072 the hardware Bloom filter supports

# Afterwards, the filter works as before
statement ok
