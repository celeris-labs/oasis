# An optional (nullable) BIGINT key on the probe side (bf_skip has more rows): 0 and 7 (twice) match
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM read_oasis('{TEST_DIR}/bf_skip.parquet') JOIN read_oasis('{TEST_DIR}/bf_ext_build.parquet') ON s_opt = e_key;
