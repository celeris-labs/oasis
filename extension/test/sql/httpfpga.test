# name: test/sql/httpfpga.test
# description: httpfpga:// FPGA read path across the TPC-H files. ROADMAP test — not all pass yet.
#   HARDWARE-GATED: needs the FPGA programmed AND MinIO reachable at http_server:http_port.
#   Run on alveo-u55c-04:  ./build/release/test/unittest "test/sql/httpfpga.test"
#   `statement ok` cases only check the query RUNS (no crash / short transfer); failures show you
#   which files/query-shapes still need work. `query` cases assert scale-independent golden values.
#
# SCOPE WARNING — this file no longer exercises the FPGA data path. Every query below uses
#   read_parquet(), which treats httpfpga:// purely as a byte source and parses on the CPU. On the
#   current bitstream the HTTP body feeds the ColumnChunkDecoder and axi_out[BYPASS_ID] is tied off,
#   so those raw byte reads are served over a host socket and the FPGA never sees them. Passing here
#   proves the object server and the Parquet plumbing work, nothing more.
#
#   To exercise the hardware these need read_oasis() instead of read_parquet() — see
#   test/sql/httpfpga_decode.test. That conversion is blocked on the GET path budget: the hardware
#   carries 32 path characters (8 CSR words) and '/testbench/tpch-30/region.parquet' is 33,
#   '/testbench/tpch-30/lineitem.parquet' is 35. Either re-stage the TPC-H objects under a shorter
#   prefix, or widen fileWord0..7 in http_config.sv (plus handler.sv / http_req_builder.sv and
#   HTTP_FILE_WORDS in software/oasis/configuration.cpp).
# group: [sql]

require oasis

# read_parquet lives in the parquet extension — load it so the httpfpga:// reads can be parsed.
require parquet

# --- config ---
statement ok
SET http_server='10.253.74.74';

statement ok
SET http_port=9000;

# Raw byte reads go over a host socket either way now (the FPGA bypass stream is tied off), so this
# is a no-op kept for clarity. `SET httpfpga_raw_bypass = true` is what re-enables the old FPGA raw
# path, and only a pre-decoder bitstream can serve it.
statement ok
SET httpfpga_cpu_fallback=false;

statement ok
SET httpfpga_debug=true;

# ============================================================================
# 1. Connectivity + scale-independent goldens (region always 5, nation always 25)
# ============================================================================
query I
SELECT count(*) FROM read_parquet('httpfpga://testbench/tpch-30/region.parquet');
----
5

# TPC-H region names are fixed — a byte-exact check of a small string column.
query I
SELECT r_name FROM read_parquet('httpfpga://testbench/tpch-30/region.parquet') ORDER BY r_regionkey;
----
AFRICA
AMERICA
ASIA
EUROPE
MIDDLE EAST

query I
SELECT count(*) FROM read_parquet('httpfpga://testbench/tpch-30/nation.parquet');
----
25

# ============================================================================
# 2. Per-file smoke: can the FPGA path read each TPC-H object at all?
# ============================================================================
statement ok
SELECT count(*) FROM read_parquet('httpfpga://testbench/tpch-30/supplier.parquet');

statement ok
SELECT count(*), min(p_partkey), max(p_partkey) FROM read_parquet('httpfpga://testbench/tpch-30/part.parquet');

statement ok
SELECT count(*), min(c_custkey), max(c_custkey) FROM read_parquet('httpfpga://testbench/tpch-30/customer.parquet');

statement ok
SELECT count(*), min(o_orderkey), max(o_orderkey) FROM read_parquet('httpfpga://testbench/tpch-30/orders.parquet');

statement ok
SELECT count(*) FROM read_parquet('httpfpga://testbench/tpch-30/partsupp.parquet');

statement ok
SELECT count(*) FROM read_parquet('httpfpga://testbench/tpch-30/lineitem.parquet');

# ============================================================================
# 3. Column-type coverage: numeric / decimal / string / date
# ============================================================================
statement ok
SELECT sum(p_size), avg(p_retailprice), max(length(p_name)) FROM read_parquet('httpfpga://testbench/tpch-30/part.parquet');

statement ok
SELECT sum(l_quantity), sum(l_extendedprice), avg(l_discount) FROM read_parquet('httpfpga://testbench/tpch-30/lineitem.parquet');

statement ok
SELECT min(o_orderdate), max(o_orderdate), count(DISTINCT o_orderstatus) FROM read_parquet('httpfpga://testbench/tpch-30/orders.parquet');

statement ok
SELECT count(DISTINCT s_nationkey), max(length(s_address)) FROM read_parquet('httpfpga://testbench/tpch-30/supplier.parquet');

# ============================================================================
# 4. GROUP BY / filters / ordering
# ============================================================================
statement ok
SELECT p_brand, count(*), avg(p_retailprice) FROM read_parquet('httpfpga://testbench/tpch-30/part.parquet') GROUP BY p_brand ORDER BY p_brand;

statement ok
SELECT l_returnflag, l_linestatus, count(*), sum(l_quantity) FROM read_parquet('httpfpga://testbench/tpch-30/lineitem.parquet') GROUP BY 1, 2 ORDER BY 1, 2;

statement ok
SELECT c_mktsegment, count(*) FROM read_parquet('httpfpga://testbench/tpch-30/customer.parquet') WHERE c_acctbal > 0 GROUP BY 1 ORDER BY 1;

# ============================================================================
# 5. Cross-file joins (fetch multiple objects in one query)
# ============================================================================
statement ok
SELECT count(*)
FROM read_parquet('httpfpga://testbench/tpch-30/part.parquet') p
JOIN read_parquet('httpfpga://testbench/tpch-30/partsupp.parquet') ps ON p.p_partkey = ps.ps_partkey;

statement ok
SELECT n_name, count(*)
FROM read_parquet('httpfpga://testbench/tpch-30/customer.parquet') c
JOIN read_parquet('httpfpga://testbench/tpch-30/nation.parquet') n ON c.c_nationkey = n.n_nationkey
GROUP BY n_name ORDER BY n_name;

statement ok
SELECT count(*)
FROM read_parquet('httpfpga://testbench/tpch-30/orders.parquet') o
JOIN read_parquet('httpfpga://testbench/tpch-30/lineitem.parquet') l ON o.o_orderkey = l.l_orderkey
WHERE l_commitdate < l_receiptdate;

# ============================================================================
# 6. TPC-H Q1 shape — the real target workload
# ============================================================================
statement ok
SELECT l_returnflag, l_linestatus,
       sum(l_quantity)                          AS sum_qty,
       sum(l_extendedprice)                     AS sum_base_price,
       sum(l_extendedprice * (1 - l_discount))  AS sum_disc_price,
       avg(l_quantity)                          AS avg_qty,
       count(*)                                 AS count_order
FROM read_parquet('httpfpga://testbench/tpch-30/lineitem.parquet')
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;

# ============================================================================
# 7. Scale check (tpch-30): larger objects, more reads, different alignments
# ============================================================================
statement ok
SELECT count(*), min(p_partkey), max(p_partkey) FROM read_parquet('httpfpga://testbench/tpch-30/part.parquet');

statement ok
SELECT count(*) FROM read_parquet('httpfpga://testbench/tpch-30/lineitem.parquet');
